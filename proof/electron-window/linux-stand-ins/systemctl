# Stand-in for systemctl --user: one unit, tatolabd.service, whose ExecStart is the local API stand-in
# beside this script, serving on $XDG_RUNTIME_DIR/streamlib/local-api.sock.
state="$SYSTEMCTL_STAND_IN_STATE"; echo "$*" >> "$state/commands"
[ "$1" = --user ] || { echo "stand-in only answers --user" >&2; exit 2; }; shift
unit_file="$state/tatolabd.service"
runtime_running() { [ -f "$state/pid" ] && kill -0 "$(cat "$state/pid")" 2>/dev/null; }
start_runtime() { runtime_running || { mkdir -p "$XDG_RUNTIME_DIR/streamlib"; nohup node "$(dirname "$0")/tatolabd-local-api-stand-in.mjs" "$XDG_RUNTIME_DIR/streamlib/local-api.sock" >/dev/null 2>&1 & echo $! > "$state/pid"; }; }
stop_runtime() { runtime_running && kill "$(cat "$state/pid")"; rm -f "$state/pid"; }
case "$1 $2 $3" in
  "is-enabled tatolabd.service ") [ -f "$unit_file" ] || { echo not-found; exit 4; }; [ -f "$state/enabled" ] && { echo enabled; exit 0; }; echo disabled; exit 1 ;;
  "enable --now tatolabd.service") [ -f "$unit_file" ] || { echo "Failed to enable unit: Unit file tatolabd.service does not exist." >&2; exit 1; }; touch "$state/enabled"; start_runtime; echo "Created symlink $HOME/.config/systemd/user/default.target.wants/tatolabd.service → $HOME/.config/systemd/user/tatolabd.service." >&2 ;;
  "disable --now tatolabd.service") rm -f "$state/enabled"; stop_runtime; echo "Removed \"$HOME/.config/systemd/user/default.target.wants/tatolabd.service\"." >&2 ;;
  "start tatolabd.service ") [ -f "$unit_file" ] || { echo "Failed to start tatolabd.service: Unit tatolabd.service not found." >&2; exit 5; }; start_runtime ;;
  *) echo "stand-in does not know: $*" >&2; exit 2 ;;
esac
