cask "tato-studio" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/tatolab/streamlib/releases/download/v#{version}/Tato-Studio-#{version}-arm64.dmg"
  name "Tato Studio"
  desc "Graph-first creative studio for real-time camera, audio and GPU streams"
  homepage "https://tatolab.com/"

  livecheck do
    url :url
    strategy :github_latest
  end

  auto_updates true
  depends_on arch: :arm64
  depends_on macos: :tahoe

  app "Tato Studio.app"

  uninstall launchctl: "com.tatolab.tatolabd",
            quit:      "com.tatolab.tatolab",
            delete:    [
              "~/.local/bin/tatolab",
              "/usr/local/bin/tatolab",
            ]

  zap trash: [
    "~/Library/Application Support/com.tatolab.tatolab",
    "~/Library/Application Support/Tatolab",
    "~/Library/Caches/com.tatolab.tatolab",
    "~/Library/Preferences/com.tatolab.tatolab.plist",
  ]
end
