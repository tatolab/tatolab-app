<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime refuses camera and microphone access without these, and never prompts. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- The runtime's relay secrets live in the data-protection keychain under this access group, which
       macOS grants by signature and never prompts for. These are restricted entitlements: the helper
       carries the Developer ID provisioning profile for com.tatolab.runtime that authorizes them. -->
  <key>com.apple.application-identifier</key>
  <string>QV2N7EDV53.com.tatolab.runtime</string>
  <key>com.apple.developer.team-identifier</key>
  <string>QV2N7EDV53</string>
  <key>keychain-access-groups</key>
  <array>
    <string>QV2N7EDV53.com.tatolab.runtime</string>
  </array>
</dict>
</plist>
