{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tatolab",
  "version": "0.45.0",
  "identifier": "com.tatolab.tatolab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2025 Jonathan Fontanez",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "macos/Tatolab.entitlements",
      "infoPlist": "macos/Info.plist"
    }
  }
}
