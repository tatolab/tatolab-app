{
  "name": "tatolab-app",
  "private": true,
  "version": "0.45.0",
  "type": "module",
  "main": "src-electron/build/src-electron/src/electron_adapters/electron_app_entry.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p src-electron && vite build",
    "build:electron": "tsc -p src-electron/tsconfig.build.json && vite build --config vite.window_preload.config.ts",
    "build:service-management-addon": "node-gyp rebuild --directory src-electron/native/service_management_agent_services",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "npm run build && npm run build:electron && electron .",
    "electron:dev": "npm run build:electron && TATOLAB_APP_WINDOW_DEV_SERVER_URL=http://localhost:1420/ electron ."
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron": "^44.9.1",
    "happy-dom": "^21.0.1",
    "lucide-react": "^1.61.0",
    "node-gyp": "^12.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "react-router": "^7.18.4",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
