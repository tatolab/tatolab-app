{
  "name": "tatolab-app-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "apps/tato-app/scripts/place-tatolab-runtime-client.sh",
    "dev": "npm run dev --workspace tato-app",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tatolab/lint-config": "github:tatolab/lint-config#266d8817c0fd108697fc7aa150616ed3068ee354",
    "oxlint": "1.91.0",
    "turbo": "2.11.10"
  }
}
