{
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(apps/tato-app/scripts/check-*)",
      "Bash(apps/tato-app/scripts/tests/*)",
      "Bash(.claude/scripts/tests/*)",
      "Bash(gh pr merge *)",
      "Bash(gh api *dispatches*)"
    ],
    "ask": [
      "Edit(LICENSE)",
      "Edit(apps/tato-app/packaging/entitlements/**)",
      "Edit(apps/tato-app/packaging/macos/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/machine-brake.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-gc.sh"
          }
        ]
      }
    ]
  }
}
