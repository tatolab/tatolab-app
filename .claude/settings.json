{
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(git fetch *)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(apps/tato-app/scripts/check-*)",
      "Bash(apps/tato-app/scripts/tests/*)",
      "Bash(gh pr merge *)",
      "Bash(gh api *dispatches*)"
    ],
    "ask": [
      "Edit(LICENSE)",
      "Edit(apps/tato-app/packaging/entitlements/**)",
      "Edit(apps/tato-app/packaging/macos/**)"
    ],
    "deny": [
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(gh issue delete*)",
      "Bash(gh issue transfer*)",
      "Bash(gh issue pin*)",
      "Bash(gh issue lock*)",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__sub_issue_write"
    ]
  },
  "extraKnownMarketplaces": {
    "tato-plugins-official": {
      "source": {
        "source": "github",
        "repo": "tatolab/tato-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "dev-plugin@tato-plugins-official": true
  }
}
