{
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(scripts/check-*)",
      "Bash(scripts/tests/*)",
      "Bash(.claude/scripts/tests/*)",
      "Bash(gh pr merge *)",
      "Bash(gh api *dispatches*)"
    ],
    "ask": [
      "Edit(LICENSE)",
      "Edit(packaging/entitlements/**)",
      "Edit(packaging/launch-agent/**)",
      "Edit(packaging/macos/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/machine-brake.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-gc.sh"
          }
        ]
      }
    ]
  }
}
