<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's plain helper hosts each utility process, the Python language server's Node among them; V8 there maps its code range writable and executable, and without this the process dies at start with SIGTRAP. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
