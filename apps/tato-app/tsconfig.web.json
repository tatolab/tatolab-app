{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/renderer/*"] }
  },
  "include": ["src/renderer", "src/shared", "mock"],
  "exclude": ["mock/mock_studio_view/picture_and_fader", "mock/mock_studio_view/css_module_scripts.d.ts", "mock/mock_project_node_ui"]
}
